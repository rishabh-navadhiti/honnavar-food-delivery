{
  "name": "honnavar-food-delivery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:e2e": "NODE_OPTIONS=--conditions=react-server playwright test",
    "screens": "NODE_OPTIONS=--conditions=react-server playwright test --config playwright.screens.config.ts",
    "db:generate": "drizzle-kit generate",
    "demo:reset": "tsx --env-file-if-exists=.env.local --conditions=react-server src/features/demo/reset.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.58.0",
    "next": "16.4",
    "next-intl": "^4.14.9",
    "postgres": "^3.4.9",
    "react": "19.3",
    "react-dom": "19.3",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.4",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  }
}
