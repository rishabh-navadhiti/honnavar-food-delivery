# App database (PostgreSQL 17). `npm run demo:reset` and `npm run test:e2e` DROP AND RECREATE it:
# point it at a disposable database, never one holding data you want to keep.
DATABASE_URL=postgres://hfd:hfd@localhost:5432/hfd

# Integration tests only (Vitest). Wiped on every `npm test` run.
TEST_DATABASE_URL=postgres://hfd:hfd@localhost:5432/hfd_test

# Language for first-time visitors: en or kn.
DEFAULT_LOCALE=en

# Shows the demo-only account panel on every sign-in screen: true or false.
DEMO_MODE=true

# The fixed one-time code accepted by the OTP stand-in (6 digits). No SMS is ever sent.
DEMO_OTP_CODE=123456

# --- Ordering (feature 002) ---

# Flat delivery fee added to every order, in whole rupees (0-500).
DELIVERY_FEE_RUPEES=30

# Minutes added to the kitchen's preparation minutes for the "Expected by" time (1-180).
DELIVERY_MINUTES=15

# Minutes a kitchen has to accept or reject a new order before it is rejected automatically (1-120).
ACCEPT_WINDOW_MINUTES=10

# Map search and the address under the pin: nominatim (OpenStreetMap's public service) or stand-in
# (fixed Honnavar places, no network; used by tests).
GEOCODING_PROVIDER=nominatim

# Nominatim server. The public one allows at most 1 request per second and no autocomplete.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Contact URL or email sent in the User-Agent, as Nominatim's usage policy requires.
GEOCODING_CONTACT=https://github.com/rishabh-navadhiti/honnavar-food-delivery

# Map tiles (URL template with {z}, {x} and {y}) and the attribution shown on every map.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors
