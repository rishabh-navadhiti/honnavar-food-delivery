# App database (PostgreSQL 17). `npm run demo:reset` and `npm run test:e2e` DROP AND RECREATE it:
# point it at a disposable database, never one holding data you want to keep.
DATABASE_URL=postgres://hfd:hfd@localhost:5432/hfd

# Integration tests only (Vitest). Wiped on every `npm test` run.
TEST_DATABASE_URL=postgres://hfd:hfd@localhost:5432/hfd_test

# Language for first-time visitors: en or kn.
DEFAULT_LOCALE=en

# Shows the demo-only account panel on every sign-in screen: true or false.
DEMO_MODE=true

# The fixed one-time code accepted by the OTP stand-in (6 digits). No SMS is ever sent.
DEMO_OTP_CODE=123456
